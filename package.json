{
  "name": "tribuna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file=.env.local workers/editing-worker.ts",
    "test:rls": "node --env-file=.env.local scripts/test-rls.mjs",
    "claude:setup": "tsx --env-file=.env.local scripts/claude-setup.ts",
    "claude:test": "tsx --conditions=react-server --env-file=.env.local scripts/claude-test.ts",
    "assets:setup": "tsx --env-file=.env.local scripts/assets-setup.ts",
    "sandbox:teste": "python3 sandbox/gerar_video_teste.py",
    "test:claude": "tsx --conditions=react-server --env-file=.env.local scripts/test-claude-contract.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@gsap/react": "^2.1.2",
