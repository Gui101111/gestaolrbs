# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Supabase (Project Settings → API Keys)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable). Projetos antigos: use a anon key em NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (service role) — NUNCA exponha no cliente.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------------------------------------------------------------
# E-mails transacionais (Resend)
# ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="TRIBUNA <nao-responda@seudominio.com.br>"
# E-mail que recebe avisos de novos projetos na fila (opcional)
ADMIN_NOTIFICATIONS_EMAIL=

# ---------------------------------------------------------------
# Pagamentos (Asaas) — sandbox | production
# ---------------------------------------------------------------
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token configurado no painel do Asaas para autenticar o webhook (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# Motor de edição (o admin também troca em /admin, sem deploy)
# navegador → o app edita no navegador de quem envia (padrão, sem custo de servidor)
# manual   → a equipe entrega pelo painel
# claude   → Claude Managed Agents edita; a equipe revisa (HUMAN_REVIEW)
# external → envia o job a um worker HTTP próprio (workers/editing-worker.ts)
# ---------------------------------------------------------------
VIDEO_EDITING_PROVIDER=navegador
# Segredo compartilhado para /api/jobs/callback (Authorization: Bearer <segredo>)
JOBS_CALLBACK_SECRET=troque-por-um-segredo-longo
# Worker externo (quando VIDEO_EDITING_PROVIDER=external)
EDITING_WORKER_URL=
EDITING_WORKER_TOKEN=

# ---------------------------------------------------------------
# Claude Managed Agents (Parte 2) — console: platform.claude.com, workspace "tribuna"
# NUNCA use prefixo NEXT_PUBLIC_ nestas variáveis.
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Revisão com Claude na edição no navegador (texto, cortes, título, grafismos)
EDITOR_MODEL=claude-opus-5-5
# Gerados por: npm run claude:setup
CLAUDE_AGENT_ID=
CLAUDE_ENVIRONMENT_ID=
CLAUDE_TOOLKIT_FILE_ID=
CLAUDE_MODEL=claude-sonnet-5-5
# Console → Webhooks → endpoint https://SEU-DOMINIO/api/webhooks/claude
# (eventos session.status_idled e session.status_terminated) → segredo whsec_...
ANTHROPIC_WEBHOOK_SIGNING_KEY=
# true: vídeos do agente esperam a liberação da equipe em /admin
HUMAN_REVIEW=true
# Limite de gasto por sessão (US$, preço de lista)
CLAUDE_SESSION_BUDGET_USD=5
# Minutos até o cron reconferir uma sessão sem webhook
CLAUDE_STALE_MINUTES=45
# Vercel Cron (/api/cron/editing): a Vercel envia Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Desenvolvimento: edita nesta máquina (ffmpeg + python3) sem chamar a API.
# Precisa de ANTHROPIC_WEBHOOK_SIGNING_KEY (qualquer whsec_ local). Nunca em produção.
# CLAUDE_LOCAL_SANDBOX=1

# Análise isolada (worker externo): modelo para o plano de edição
ANTHROPIC_MODEL=claude-opus-5-5
TRANSCRIPTION_URL=

# Docker / EasyPanel: gera build standalone
# NEXT_OUTPUT=standalone
