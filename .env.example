# ── Inteligência artificial (usadas só no servidor, nunca vão para o navegador) ──
# Transcrição com marcação de tempo palavra por palavra (Whisper).
OPENAI_API_KEY=
# Alternativa mais barata para a transcrição (opcional). Usada se OPENAI_API_KEY estiver vazia.
GROQ_API_KEY=
# Planejamento da edição (cortes, destaques, leitura do prompt adicional) com Claude.
ANTHROPIC_API_KEY=

# ── Contas de usuário com Supabase (opcional) ──
# Sem estas variáveis o app funciona em "modo local": as contas e os projetos
# ficam salvos no próprio navegador. Com elas, cada conta fica salva na nuvem.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
