# Higgsfield API credentials.
#
# OPTIONAL. The easier route is the app's Settings page, which stores your key
# in a local database. Use this file instead if you'd rather keep the key out
# of the database, or run the app headless.
#
# Copy this file to `.env.local` and fill both values in. A Higgsfield key has
# TWO parts — create one at https://higgsfield.ai/?fpr=diogo-automates
# (Console -> API keys).
#
# `.env.local` is gitignored. Never commit it, and never put a real credential
# in `.env.example`.

HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Password for opening the app from another device, such as a phone on the
# same Wi-Fi (Iniciar-app-celular.cmd and Gerar-link-celular.cmd ask for it and
# write it here). At least 8 letters or digits. Leave unset for localhost-only use.
APP_PASSWORD=

# Where the database and downloaded media live (default: ./storage). Point it at
# a persistent disk when hosting, e.g. /var/data on Render.
STORAGE_DIR=
